{
  "components": {
    "schemas": {
      "AssistantReply": {
        "description": "Ответ ассистента на реплику.",
        "properties": {
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "title": "Choices",
            "type": "array"
          },
          "conflicts": {
            "description": "Встречи, с которыми пересекается новая",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Conflicts",
            "type": "array"
          },
          "events": {
            "description": "Созданные / изменённые / найденные записи",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Events",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/ReplyKind"
          },
          "message_id": {
            "description": "id реплики ассистента в истории",
            "title": "Message Id",
            "type": "integer"
          },
          "pending": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pending"
              },
              {
                "type": "null"
              }
            ]
          },
          "period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Period"
              },
              {
                "type": "null"
              }
            ]
          },
          "recognized_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Что распознано из голоса (только для `/api/voice`)",
            "title": "Recognized Text"
          },
          "text": {
            "description": "Текст ответа; его же озвучиваем",
            "title": "Text",
            "type": "string"
          },
          "undo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Undo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "message_id",
          "kind",
          "text",
          "recognized_text",
          "events",
          "period",
          "choices",
          "conflicts",
          "pending",
          "undo"
        ],
        "title": "AssistantReply",
        "type": "object"
      },
      "Body_send_voice_message": {
        "properties": {
          "audio": {
            "contentMediaType": "application/octet-stream",
            "description": "Запись голоса",
            "title": "Audio",
            "type": "string"
          }
        },
        "required": [
          "audio"
        ],
        "title": "Body_send_voice_message",
        "type": "object"
      },
      "ChatMessage": {
        "description": "Реплика в истории диалога.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "reply": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssistantReply"
              },
              {
                "type": "null"
              }
            ],
            "description": "Полный ответ — для реплик ассистента"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "text",
          "created_at",
          "reply"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "description": "Текстовая реплика пользователя.",
        "properties": {
          "text": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "Choice": {
        "description": "Пронумерованный вариант, когда подходит несколько записей.",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "index": {
            "description": "Номер варианта, с 1",
            "minimum": 1.0,
            "title": "Index",
            "type": "integer"
          }
        },
        "required": [
          "index",
          "event"
        ],
        "title": "Choice",
        "type": "object"
      },
      "DialogResponse": {
        "description": "История диалога, новые реплики в конце.",
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "title": "DialogResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Код ошибки из контракта и сообщение для пользователя.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "description": "Сообщение по-русски, пригодное для показа пользователю",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Коды ошибок из контракта API.",
        "enum": [
          "validation_error",
          "not_found",
          "rate_limited",
          "audio_unsupported",
          "audio_too_large",
          "speech_not_recognized",
          "llm_unavailable",
          "stt_unavailable",
          "tts_unavailable",
          "invalid_recovery_code",
          "not_implemented",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "`{\"error\": {\"code\": …, \"message\": …}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Event": {
        "description": "Задача, напоминание или встреча.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Конец встречи (по умолчанию начало + 60 мин); у задач и напоминаний `null`",
            "title": "Ends At"
          },
          "has_time": {
            "description": "`false` — указан только день: время в `starts_at` = 00:00 и не показывается",
            "title": "Has Time",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/EventSource",
            "description": "`import` — история из CSV"
          },
          "starts_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Срок задачи, время напоминания, начало встречи; `null` — задача без срока",
            "title": "Starts At"
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "title": {
            "description": "Название / текст",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "starts_at",
          "has_time",
          "ends_at",
          "status",
          "source",
          "created_at",
          "updated_at"
        ],
        "title": "Event",
        "type": "object"
      },
      "EventCreate": {
        "additionalProperties": false,
        "description": "Создание записи из интерфейса.",
        "properties": {
          "ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "has_time": {
            "default": true,
            "description": "`false` — у записи только дата, без времени",
            "title": "Has Time",
            "type": "boolean"
          },
          "starts_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts At"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          }
        },
        "required": [
          "type",
          "title"
        ],
        "title": "EventCreate",
        "type": "object"
      },
      "EventSource": {
        "description": "Откуда появилась запись: от пользователя или из импорта истории CSV.",
        "enum": [
          "user",
          "import"
        ],
        "title": "EventSource",
        "type": "string"
      },
      "EventStatus": {
        "description": "Статус выполнения записи.",
        "enum": [
          "open",
          "done"
        ],
        "title": "EventStatus",
        "type": "string"
      },
      "EventType": {
        "description": "Вид записи.",
        "enum": [
          "task",
          "reminder",
          "meeting"
        ],
        "title": "EventType",
        "type": "string"
      },
      "EventUpdate": {
        "additionalProperties": false,
        "description": "Изменение записи: передаются только меняющиеся поля.",
        "properties": {
          "ends_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "has_time": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has Time"
          },
          "starts_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts At"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "EventUpdate",
        "type": "object"
      },
      "EventsResponse": {
        "description": "Список записей.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventsResponse",
        "type": "object"
      },
      "HealthChecks": {
        "description": "Состояние зависимостей.",
        "properties": {
          "db": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Db",
            "type": "string"
          },
          "llm": {
            "$ref": "#/components/schemas/ServiceStatus"
          },
          "stt": {
            "$ref": "#/components/schemas/ServiceStatus"
          },
          "tts": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "required": [
          "db",
          "llm",
          "stt",
          "tts"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Ответ `GET /api/health`.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MessageRole": {
        "description": "Автор реплики в истории диалога.",
        "enum": [
          "user",
          "assistant"
        ],
        "title": "MessageRole",
        "type": "string"
      },
      "Pending": {
        "description": "Чего ассистент ждёт от пользователя.",
        "properties": {
          "expects": {
            "$ref": "#/components/schemas/PendingExpectation"
          },
          "question": {
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "expects",
          "question"
        ],
        "title": "Pending",
        "type": "object"
      },
      "PendingExpectation": {
        "description": "Чего ассистент ждёт от пользователя в следующей реплике.",
        "enum": [
          "date",
          "time",
          "datetime",
          "choice",
          "confirm",
          "title"
        ],
        "title": "PendingExpectation",
        "type": "string"
      },
      "Period": {
        "description": "Период, за который показан список.",
        "properties": {
          "from": {
            "format": "date-time",
            "title": "From",
            "type": "string"
          },
          "label": {
            "examples": [
              "сегодня",
              "на этой неделе"
            ],
            "title": "Label",
            "type": "string"
          },
          "to": {
            "format": "date-time",
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "label"
        ],
        "title": "Period",
        "type": "object"
      },
      "Profile": {
        "description": "Анонимный профиль.",
        "properties": {
          "calendar_subscription_url": {
            "description": "Ссылка подписки: `webcal://…/api/calendar/{token}.ics`",
            "title": "Calendar Subscription Url",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "events_count": {
            "title": "Events Count",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "recovery_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Код восстановления; только в ответе на создание профиля, иначе `null`",
            "examples": [
              "сирень-лиса-кедр-4821"
            ],
            "title": "Recovery Code"
          },
          "timezone": {
            "description": "Всегда `Europe/Moscow`",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "timezone",
          "events_count",
          "calendar_subscription_url",
          "recovery_code"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ReplyKind": {
        "description": "Как фронту показать ответ ассистента.",
        "enum": [
          "confirmation",
          "list",
          "search_results",
          "clarification",
          "choice",
          "confirm_request",
          "info"
        ],
        "title": "ReplyKind",
        "type": "string"
      },
      "RestoreRequest": {
        "additionalProperties": false,
        "description": "Вход в профиль по коду восстановления.",
        "properties": {
          "code": {
            "examples": [
              "сирень-лиса-кедр-4821"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "RestoreRequest",
        "type": "object"
      },
      "ServiceStatus": {
        "description": "Состояние зависимости в проверке живости.",
        "enum": [
          "ok",
          "fail",
          "unknown"
        ],
        "title": "ServiceStatus",
        "type": "string"
      },
      "TtsRequest": {
        "additionalProperties": false,
        "description": "Текст для озвучки.",
        "properties": {
          "text": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "voice": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          }
        },
        "required": [
          "text"
        ],
        "title": "TtsRequest",
        "type": "object"
      },
      "Undo": {
        "description": "Действие можно отменить до `expires_at` (окно 10 секунд).",
        "properties": {
          "action_id": {
            "title": "Action Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "expires_at"
        ],
        "title": "Undo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ProfileSession": {
        "description": "Анонимный профиль. Если cookie нет или она недействительна, эндпоинт создаёт новый профиль и ставит cookie сам.",
        "in": "cookie",
        "name": "gorky_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Голосовой ассистент задач и встреч. Человекочитаемый контракт — `docs/api-contract.md`.",
    "title": "Горький API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/actions/{action_id}/undo": {
      "post": {
        "description": "Работает 10 секунд после действия, потом — 404.",
        "operationId": "undo_action",
        "parameters": [
          {
            "in": "path",
            "name": "action_id",
            "required": true,
            "schema": {
              "title": "Action Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`not_found`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`internal_error`"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`not_implemented`"
          }
        },
        "security": [
          {
            "ProfileSession": []
          }
        ],
        "summary": "Отменить действие",
        "tags": [
          "dialog"
        ]
      }
    },
    "/api/calendar.ics": {
      "get": {
        "description": "Все предстоящие записи профиля, файлом (attachment).",
        "operationId": "download_calendar",
        "responses": {
          "200": {
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Календарь iCalendar"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`internal_error`"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`not_implemented`"
          }
        },
        "security": [
          {
            "ProfileSession": []
          }
        ],
        "summary": "Скачать .ics",
        "tags": [
          "calendar"
        ]
      }
    },
    "/api/calendar/{token}.ics": {
      "get": {
        "description": "По секретному токену, без cookie. Напоминания — с `VALARM`.",
        "operationId": "subscribe_calendar",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Календарь iCalendar"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`not_found`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`validation_error`"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`internal_error`"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`not_implemented`"
          }
        },
        "summary": "Подписка на календарь",
