# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- База данных -------------------------------------------------------------
# Пароль пользователя gorky в контейнере db (docker-compose). Меняйте вместе с DATABASE_URL.
POSTGRES_PASSWORD=gorky
# Подключение бэкенда при локальной разработке (make dev): контейнер db на 127.0.0.1:5433.
# В docker-compose бэкенд получает свой DATABASE_URL (хост db) — эта строка там не используется.
DATABASE_URL=postgresql+asyncpg://gorky:gorky@127.0.0.1:5433/gorky
# Отдельная база для pytest; создаётся тестами автоматически. Пусто — интеграционные тесты пропускаются.
DATABASE_URL_TEST=postgresql+asyncpg://gorky:gorky@127.0.0.1:5433/gorky_test

# --- Безопасность ------------------------------------------------------------
# Ключ HMAC для кодов восстановления, не короче 32 символов. Сгенерировать:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Смена ключа делает недействительными все выданные коды восстановления.
APP_SECRET=
# Флаг Secure у cookie профиля: true в проде (HTTPS), false для http://localhost.
COOKIE_SECURE=true
# Origin браузера при создании профиля. JSON-массив, без завершающего /.
# Локально (включая Docker через Next proxy); в проде укажите только реальный HTTPS origin.
PROFILE_CREATION_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]

# --- Адреса ------------------------------------------------------------------
# Публичный адрес сайта; из него строится ссылка подписки webcal://<host>/api/calendar/<token>.ics
PUBLIC_BASE_URL=https://voice.wexasas.online
# Куда фронт (Next.js) проксирует /api. Локально — бэкенд из make dev; в docker-compose
# адрес передаётся фронту аргументом сборки (rewrites Next.js вычисляются при build).
BACKEND_URL=http://127.0.0.1:8100

# --- Поиск по смыслу -----------------------------------------------------------
# real — локальная модель эмбеддингов + pymorphy3; placeholder — заглушки без модели (тесты).
SEARCH_BACKEND=real
EMBEDDING_MODEL=deepvk/USER-bge-m3
# Каталог весов. Локально — абсолютный путь к ./models репозитория (он в .gitignore);
# в docker-compose переопределяется на /models (том). Пусто — кэш Hugging Face по умолчанию.
EMBEDDING_CACHE_DIR=

# --- Голос: распознавание (GigaAM / Whisper) и синтез (Silero) ------------------
# real — модели речи; disabled — /api/voice и /api/tts отвечают 503 (тесты).
VOICE_BACKEND=real
# gigaam — GigaAM-v3 (onnx-asr, ~220 МБ, доли секунды на фразу); whisper — запасной.
STT_ENGINE=gigaam
STT_GIGAAM_MODEL=gigaam-v3-e2e-rnnt
# Модель Whisper при STT_ENGINE=whisper: large-v3-turbo / medium / small.
STT_MODEL=large-v3-turbo
STT_CPU_THREADS=8
STT_WARM_UP_ON_STARTUP=true
TTS_VOICE=baya
TTS_WARM_UP_ON_STARTUP=true
# Каталоги весов. Локально — абсолютные пути к ./models и ./models/silero репозитория
# (в .gitignore), иначе модели заново скачаются в ~/.cache. В Docker оставить
# пустыми: веса лягут в том /models через HF_HOME и TORCH_HOME из docker-compose.
STT_CACHE_DIR=
TTS_CACHE_DIR=

# --- Языковая модель -------------------------------------------------------------
# gigachat — разбор реплик через GigaChat API; disabled — без LLM (чат отвечает 503).
LLM_BACKEND=gigachat

# --- GigaChat API ------------------------------------------------------------
# Ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_CLIENT_ID=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Необязательно: путь к корневому сертификату Минцифры. Пусто — infra/certs из репозитория
# (локально) или системное хранилище (Docker). GIGACHAT_CA_BUNDLE_FILE не задавать:
# SDK заменит им весь набор сертификатов.
GIGACHAT_ROOT_CA_FILE=
