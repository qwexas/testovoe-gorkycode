{
  "name": "gorky-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
