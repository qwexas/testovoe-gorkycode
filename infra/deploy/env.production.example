# .env на сервере (~/gorkycode/.env). Создаётся один раз, в git и rsync не попадает.

# Порты на 127.0.0.1 (на сервере 3100/8100 заняты Life OS) — их же слушает nginx-vhost.
FRONTEND_PORT=3210
BACKEND_PORT=8210
DB_PORT=5434

POSTGRES_PASSWORD=<случайная строка>
APP_SECRET=<случайная строка>
COOKIE_SECURE=true
PROFILE_CREATION_ORIGINS=["https://voice.wexasas.online"]
PUBLIC_BASE_URL=https://voice.wexasas.online

# Веса моделей — каталог ./models рядом с compose (заполняет sync-models.sh).
MODELS_DIR=./models
# После того как веса на месте — не ходить в Hugging Face при старте.
HF_HUB_OFFLINE=1

SEARCH_BACKEND=real
EMBEDDING_MODEL=deepvk/USER-bge-m3
VOICE_BACKEND=real
# GigaAM-v3 на Xeon: 0,18 с на фразу; Whisper medium (запасной) — 5,5 с.
STT_ENGINE=gigaam
STT_MODEL=medium
STT_CPU_THREADS=8
TTS_VOICE=baya
LLM_BACKEND=gigachat

GIGACHAT_CREDENTIALS=<ключ авторизации>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
